page {
  --primary: #2f6cf6;
  --primary-light: #e6f0ff;
  --primary-dark: #1a4fd0;
  --success: #22c55e;
  --success-light: #dcfce7;
  --warning: #f59e0b;
  --warning-light: #fef3c7;
  --danger: #ef4444;
  --danger-light: #fce4ec;
  --gray-1: #f5f5f5;
  --gray-2: #e5e7eb;
  --gray-3: #d1d5db;
  --gray-4: #9ca3af;
  --gray-5: #6b7280;
  --gray-6: #4b5563;
  --gray-7: #374151;
  --text-primary: #111827;
  --text-secondary: #6b7280;
  --text-tertiary: #9ca3af;
  --text-hint: #9ca3af;
  --bg-page: #f5f5f5;
  --bg-card: #ffffff;
  --radius-sm: 8rpx;
  --radius-md: 12rpx;
  --radius-lg: 16rpx;
  --radius-xl: 24rpx;
  --shadow-sm: 0 1rpx 2rpx rgba(0,0,0,0.05);
  --shadow-md: 0 4rpx 12rpx rgba(0,0,0,0.08);
  font-size: 28rpx;
  color: var(--text-primary);
  background: var(--bg-page);
  box-sizing: border-box;
}

view, text, image, button, input, textarea {
  box-sizing: border-box;
}

/* 通用卡片 */
.card {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 24rpx;
  margin: 16rpx 24rpx;
  box-shadow: var(--shadow-sm);
}

/* 通用按钮 */
.btn-primary {
  background: var(--primary);
  color: #fff;
  border-radius: var(--radius-md);
  padding: 20rpx 0;
  font-size: 28rpx;
  text-align: center;
  width: 100%;
  border: none;
}

.btn-outline {
  background: transparent;
  color: var(--primary);
  border: 2rpx solid var(--primary);
  border-radius: var(--radius-md);
  padding: 18rpx 0;
  font-size: 28rpx;
  text-align: center;
  width: 100%;
}

/* 通用标签 */
.tag {
  display: inline-block;
  background: var(--primary-light);
  color: var(--primary);
  border-radius: 24rpx;
  padding: 8rpx 20rpx;
  font-size: 24rpx;
  margin-right: 12rpx;
  margin-bottom: 8rpx;
}

/* 分割线 */
.divider {
  height: 1rpx;
  background: var(--gray-2);
  margin: 16rpx 0;
}

/* 含底部自定义 Tab（中间 +）的页面，避免最后一屏被挡住 */
.page,
.page-white {
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* 与 navigationBarTitleText 重复主标题时不要再用 .page-title */
.page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 24rpx 16rpx;
}

.page-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.page-subtitle {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

/* 页面加载动画 */
.page-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx 0;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid var(--gray-3);
  border-top-color: var(--primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}

.empty-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 8rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: var(--text-tertiary);
}
