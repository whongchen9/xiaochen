<!-- 小陈助手：悬浮球 + 弹层（与全屏 chat 页互斥挂载） -->
<view class="xc-root" wx:if="{{!disabled}}">
  <view
    class="xc-fab"
    style="bottom: {{fabBottom}}rpx;"
    bindtap="onFabTap"
    hover-class="xc-fab-hover"
    hover-stay-time="80"
  >
    <text class="xc-fab-txt">小陈</text>
  </view>

  <view class="xc-mask" wx:if="{{dialogOpen}}" catchtouchmove="noop" bindtap="onMaskTap">
    <view class="xc-panel" catchtap="noop">
      <view class="xc-panel-hd">
        <text class="xc-panel-title">小陈助手</text>
        <text class="xc-panel-close" bindtap="closeDialog">✕</text>
      </view>
      <text class="xc-panel-sub">快捷问一句；复杂协作可进完整对话（含计划书 P）</text>

      <scroll-view scroll-y class="xc-msg-scroll" scroll-into-view="{{scrollToId}}" scroll-with-animation="{{true}}">
        <block wx:for="{{messages}}" wx:key="id">
          <view class="xc-row xc-ai" wx:if="{{item.role === 'ai'}}">
            <view class="xc-av xc-av-ai">陈</view>
            <view class="xc-bubble xc-bubble-ai">
              <text class="xc-msg-text">{{item.content}}</text>
            </view>
          </view>
          <view class="xc-row xc-user" wx:else>
            <view class="xc-bubble xc-bubble-user">
              <text class="xc-msg-text">{{item.content}}</text>
            </view>
            <view class="xc-av xc-av-user">我</view>
          </view>
        </block>
        <view class="xc-loading" wx:if="{{isLoading}}"><text>…</text></view>
        <view id="xc-msg-bottom" class="xc-msg-bottom" />
      </scroll-view>

      <view class="xc-panel-actions">
        <text class="xc-link" bindtap="openFullChat">进入完整对话 ›</text>
      </view>

      <view class="xc-input-row">
        <input
          class="xc-input"
          type="text"
          placeholder="问小陈…"
          value="{{inputValue}}"
          bindinput="onInput"
          confirm-type="send"
          bindconfirm="onSend"
        />
        <view class="xc-send {{canSend ? 'on' : ''}}" bindtap="onSend"><text>发送</text></view>
      </view>
    </view>
  </view>
</view>
