/* 勿设 0 尺寸，部分机型上会影响子节点 fixed 可点区域 */
.xc-root {
  pointer-events: none;
}

.xc-fab {
  position: fixed;
  right: 24rpx;
  z-index: 9990;
  width: 108rpx;
  height: 108rpx;
  pointer-events: auto;
  border-radius: 50%;
  background: linear-gradient(145deg, #3b82f6, #2563eb);
  box-shadow: 0 10rpx 28rpx rgba(47, 108, 246, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
}

.xc-fab-hover {
  opacity: 0.92;
}

.xc-fab-txt {
  font-size: 26rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1;
}

.xc-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 10000;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.xc-panel {
  max-height: 78vh;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  min-height: 0;
}

.xc-panel-hd {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.xc-panel-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary, #111827);
}

.xc-panel-close {
  font-size: 36rpx;
  color: var(--text-tertiary, #9ca3af);
  padding: 8rpx 16rpx;
  line-height: 1;
}

.xc-panel-close:active {
  opacity: 0.7;
}

.xc-panel-sub {
  display: block;
  font-size: 22rpx;
  color: var(--text-tertiary, #6b7280);
  line-height: 1.45;
  margin-bottom: 16rpx;
}

.xc-msg-scroll {
  flex: 1;
  min-height: 200rpx;
  max-height: 52vh;
  margin-bottom: 12rpx;
}

.xc-msg-bottom {
  height: 8rpx;
}

.xc-row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.xc-ai {
  justify-content: flex-start;
  gap: 12rpx;
}

.xc-user {
  justify-content: flex-end;
  gap: 12rpx;
}

.xc-av {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 700;
}

.xc-av-ai {
  background: #dbeafe;
  color: #2563eb;
}

.xc-av-user {
  background: #e5e7eb;
  color: #4b5563;
}

.xc-bubble {
  max-width: 76%;
  padding: 16rpx 20rpx;
  border-radius: 20rpx;
  box-sizing: border-box;
}

.xc-bubble-ai {
  background: #f3f4f6;
}

.xc-bubble-user {
  background: linear-gradient(135deg, #3b82f6, #2563eb);
}

.xc-msg-text {
  font-size: 28rpx;
  line-height: 1.55;
  white-space: pre-wrap;
  word-break: break-word;
}

.xc-bubble-user .xc-msg-text {
  color: #fff;
}

.xc-bubble-ai .xc-msg-text {
  color: #374151;
}

.xc-loading {
  text-align: center;
  color: #9ca3af;
  font-size: 40rpx;
  padding: 12rpx;
}

.xc-panel-actions {
  margin-bottom: 12rpx;
}

.xc-link {
  font-size: 26rpx;
  color: #2563eb;
  font-weight: 600;
}

.xc-link:active {
  opacity: 0.85;
}

.xc-input-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  padding-top: 8rpx;
  border-top: 1rpx solid #e5e7eb;
}

.xc-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  padding: 0 20rpx;
  background: #f9fafb;
  border-radius: 36rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.xc-send {
  flex-shrink: 0;
  padding: 0 28rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 36rpx;
  background: #e5e7eb;
  font-size: 28rpx;
  color: #9ca3af;
  font-weight: 600;
}

.xc-send.on {
  background: #2563eb;
  color: #fff;
}

.xc-send:active {
  opacity: 0.9;
}
