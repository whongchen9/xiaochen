.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
  background: #ffffff;
  border-top: 1rpx solid #e5e7eb;
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: border-box;
}

.tab-bar-inner {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  justify-content: space-around;
  height: 100rpx;
  padding: 0 8rpx;
  box-sizing: border-box;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  padding-bottom: 8rpx;
  min-width: 0;
}

.tab-item:active {
  opacity: 0.75;
}

.tab-emoji {
  font-size: 40rpx;
  line-height: 1;
  margin-bottom: 4rpx;
}

.tab-text {
  font-size: 20rpx;
  color: #9ca3af;
}

.tab-text.on {
  color: #2f6cf6;
  font-weight: 600;
}

.tab-plus-wrap {
  flex-shrink: 0;
  width: 120rpx;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding-bottom: 20rpx;
}

.tab-plus {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #3b82f6, #2563eb);
  box-shadow: 0 8rpx 24rpx rgba(47, 108, 246, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
}

.tab-plus-wrap:active .tab-plus {
  opacity: 0.9;
}

.tab-plus-txt {
  font-size: 52rpx;
  font-weight: 300;
  color: #fff;
  line-height: 1;
  margin-top: -6rpx;
}
