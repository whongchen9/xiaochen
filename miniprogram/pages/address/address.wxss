.page {
  min-height: 100vh;
  background: #f5f6fa;
  padding: 24rpx;
  box-sizing: border-box;
  padding-bottom: 48rpx;
}

.section-title {
  font-size: 26rpx;
  color: #666;
  margin: 16rpx 0 12rpx;
}

.addr-list {
  margin-bottom: 24rpx;
}

.addr-item {
  display: flex;
  align-items: flex-start;
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid #eee;
}

.addr-main {
  flex: 1;
}

.addr-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.addr-phone {
  font-size: 24rpx;
  color: #888;
  margin-left: 12rpx;
}

.addr-detail {
  display: block;
  font-size: 26rpx;
  color: #555;
  margin-top: 8rpx;
  line-height: 1.5;
}

.addr-del {
  font-size: 26rpx;
  color: #f56c6c;
  padding: 8rpx 0 8rpx 16rpx;
}

.addr-empty {
  text-align: center;
  color: #999;
  font-size: 26rpx;
  padding: 24rpx;
}

.form {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  border: 1rpx solid #eee;
}

.input {
  height: 80rpx;
  border-bottom: 1rpx solid #f0f0f0;
  font-size: 28rpx;
  margin-bottom: 16rpx;
}

.textarea {
  width: 100%;
  min-height: 160rpx;
  font-size: 28rpx;
  margin-bottom: 24rpx;
  box-sizing: border-box;
}

.btn-save {
  background: #2f6cf6;
  color: #fff;
  border-radius: 12rpx;
  font-size: 30rpx;
}

.btn-clear {
  margin-top: 16rpx;
  background: #f5f6fa;
  color: #666;
  font-size: 28rpx;
}
