/* 聊天页面专属样式 */

.page-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  background: var(--bg-page);
}

/* 落地页：底部进入 AI 协作对话 */
.chat-landing {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-height: 0;
  padding: 48rpx 40rpx;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.chat-landing-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 16rpx;
}
.chat-landing-kicker {
  font-size: 24rpx;
  color: var(--primary);
  font-weight: 500;
}
.chat-landing-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.35;
}
.chat-landing-desc {
  font-size: 26rpx;
  color: var(--text-hint);
  line-height: 1.55;
  margin-top: 8rpx;
}
.chat-landing-footer {
  flex-shrink: 0;
  padding-top: 32rpx;
}
.chat-landing-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 28rpx 32rpx;
  background: var(--primary);
  color: #fff;
  border-radius: var(--radius-lg);
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(47, 108, 246, 0.28);
}
.chat-landing-btn:active {
  opacity: 0.9;
}
.chat-landing-btn-hover {
  opacity: 0.92;
}
.chat-landing-btn-plus {
  font-size: 36rpx;
  line-height: 1;
}

.cs-ai-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin: 0 24rpx 8rpx;
  padding: 12rpx 16rpx;
  background: #f0f5ff;
  border-radius: var(--radius-md);
  border: 1rpx solid #dbe4ff;
}
.cs-ai-banner-text { font-size: 22rpx; color: var(--text-secondary); flex: 1; }
.cs-ai-banner-link { font-size: 22rpx; color: var(--primary); flex-shrink: 0; }

.room-cs-panel {
  margin: 0 24rpx 16rpx;
  padding: 16rpx;
  background: var(--bg-card);
  border-radius: var(--radius-md);
  border: 1rpx solid var(--border-light);
}
.room-cs-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12rpx; }
.room-cs-label { font-size: 26rpx; color: var(--text-primary); flex: 1; padding-right: 16rpx; }
.room-cs-bind {
  padding: 14rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--primary);
  background: var(--primary-light);
  border-radius: var(--radius-md);
  margin-bottom: 10rpx;
}
.room-cs-bind.on { font-weight: 500; }
.room-cs-tip { font-size: 22rpx; color: var(--text-hint); line-height: 1.5; display: block; }

.msg-bubble-cs { background: #eef8ff; border: 1rpx solid #cce5ff; }
.msg-cs-tag { font-size: 20rpx; color: var(--primary); display: block; margin-bottom: 6rpx; }
.msg-cs-row .msg-bubble-ai { background: #eef8ff; }

.room-quick-bar { padding: 12rpx 0 20rpx; }
.room-invite-hint {
  display: block;
  margin-top: 16rpx;
  padding: 0 8rpx;
  font-size: 22rpx;
  color: var(--text-hint);
  line-height: 1.45;
}
.room-quick-btn {
  background: var(--primary);
  color: #fff;
  text-align: center;
  padding: 22rpx;
  border-radius: var(--radius-md);
  font-size: 28rpx;
}
.room-quick-btn:active { opacity: 0.9; }
.room-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 20rpx;
  background: var(--bg-card);
  border-radius: var(--radius-md);
  margin-bottom: 16rpx;
  border: 1rpx solid var(--border-light);
}
.room-row:active { opacity: 0.85; }
.room-row-main { flex: 1; min-width: 0; }
.room-row-title { font-size: 28rpx; font-weight: 500; color: var(--text-primary); display: block; }
.room-row-meta { font-size: 22rpx; color: var(--text-hint); margin-top: 6rpx; display: block; }
.room-row-arrow { font-size: 36rpx; color: var(--text-hint); margin-left: 12rpx; }
.room-empty { text-align: center; color: var(--text-hint); font-size: 26rpx; padding: 80rpx 24rpx; }

.ai-collab-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 0 0 16rpx;
  padding: 12rpx 8rpx;
  border-bottom: 1rpx solid var(--border-light);
}
.ai-collab-bar-title {
  flex: 1;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-secondary);
}

.room-chat-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid var(--border-light);
}
.room-chat-back { font-size: 28rpx; color: var(--primary); flex-shrink: 0; }
.room-chat-title {
  font-size: 28rpx;
  font-weight: 600;
  flex: 1;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.room-share-btn {
  margin: 0;
  padding: 0 16rpx;
  height: 56rpx;
  line-height: 56rpx;
  font-size: 24rpx;
  background: var(--primary-light);
  color: var(--primary);
  border: none;
  border-radius: 28rpx;
  flex-shrink: 0;
}
.room-share-btn::after {
  border: none;
}

.room-tools-bar {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 6rpx 12rpx;
  margin-bottom: 16rpx;
  padding: 14rpx 18rpx;
  background: #f1f5f9;
  border-radius: 12rpx;
}
.room-tools-bar-text {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary);
}
.room-tools-bar-sub {
  font-size: 22rpx;
  color: var(--text-hint);
  flex: 1;
  min-width: 200rpx;
}
.room-tools-bar-chev {
  font-size: 26rpx;
  color: var(--text-secondary);
  flex-shrink: 0;
}

.room-msg-img {
  display: block;
  max-width: 420rpx;
  border-radius: 12rpx;
  margin-bottom: 8rpx;
}

.input-bar-muted { justify-content: center; }
.input-muted-text { font-size: 24rpx; color: var(--text-hint); }

