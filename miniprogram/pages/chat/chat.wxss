.msg-avatar-user { background: #dbeafe; overflow: hidden; margin-left: 12rpx; margin-right: 4rpx; }
.msg-avatar-img { width: 100%; height: 100%; border-radius: 50%; }
.msg-bubble { padding: 20rpx 28rpx; border-radius: 28rpx; font-size: 28rpx; line-height: 1.7; word-break: break-word; }
.msg-bubble-ai { background: #eaecf0; color: var(--text-primary); border-top-left-radius: 8rpx; }
.msg-bubble-user { background: var(--primary); color: #fff; border-bottom-right-radius: 8rpx; }
.msg-text { display: block; }
.msg-system { text-align: center; margin: 16rpx 0; font-size: 24rpx; color: #999; }

/* 璁㈠崟鍗＄墖 */
.order-card { background: #f8f9ff; border-radius: var(--radius-md); padding: 16rpx; margin-top: 14rpx; border: 1rpx solid #e0e5ff; }
.order-card-header { font-weight: 600; font-size: 28rpx; margin-bottom: 12rpx; color: var(--primary); }
.order-card-row { display: flex; justify-content: space-between; margin-bottom: 6rpx; font-size: 26rpx; }
.order-label { color: #999; flex-shrink: 0; margin-right: 16rpx; }
.order-value { color: var(--text-primary); text-align: right; }
.order-card-divider { height: 1rpx; background: #e0e5ff; margin: 10rpx 0; }
.order-card-total { display: flex; justify-content: space-between; font-size: 30rpx; font-weight: 600; }
.order-price { color: var(--primary); font-size: 34rpx; }
.order-card-actions { display: flex; gap: 16rpx; margin-top: 16rpx; }
.btn-order-cancel { flex: 1; height: 64rpx; line-height: 64rpx; text-align: center; border-radius: 32rpx; font-size: 26rpx; background: var(--bg-input); color: var(--text-secondary); border: none; }
.btn-order-confirm { flex: 1; height: 64rpx; line-height: 64rpx; text-align: center; border-radius: 32rpx; font-size: 26rpx; background: var(--primary); color: #fff; border: none; }
.btn-order-cancel:active, .btn-order-confirm:active { opacity: 0.8; }
.order-pay-row { margin-top: 14rpx; }
.btn-pay-mock { width: 100%; height: 72rpx; line-height: 72rpx; text-align: center; border-radius: var(--radius-md); font-size: 28rpx; background: var(--success); color: #fff; border: none; }
.btn-pay-mock:active { opacity: 0.9; }

/* 璇勫垎 */
.rating-card { text-align: center; padding: 16rpx 0; margin-top: 12rpx; border-top: 1rpx solid var(--border-light); }
.rating-title { font-size: 26rpx; color: var(--text-secondary); margin-bottom: 10rpx; }
.rating-stars { display: flex; justify-content: center; gap: 8rpx; }
.star { font-size: 40rpx; }

/* 鍔犺浇 */
.loading-dot { padding: 8rpx 0; color: #999; font-size: 48rpx; letter-spacing: 8rpx; animation: blink 1.4s infinite; }

.msg-time { display: block; font-size: 20rpx; color: rgba(255,255,255,.5); margin-top: 4rpx; }
.msg-time-user { text-align: right; color: rgba(255,255,255,.6); }

