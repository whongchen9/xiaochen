  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  display: block;
  margin-bottom: 12rpx;
}
.plan-card-summary {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.55;
  white-space: pre-wrap;
  display: block;
  margin-bottom: 16rpx;
}
.plan-card-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 12rpx;
  border-top: 1rpx solid rgba(47, 108, 246, 0.15);
}
.plan-card-row-switch {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.plan-card-switch-label {
  font-size: 26rpx;
  color: var(--text-secondary);
}
.plan-card-edit {
  font-size: 26rpx;
  color: var(--primary);
  font-weight: 500;
  padding: 12rpx 20rpx;
}
.plan-card-edit:active {
  opacity: 0.75;
}

/* 陌生人匹配：弱提示、邀请条、底部匹配块（A1b·A7b·A8b） */
.stranger-weak-strip {
  flex-shrink: 0;
  margin: 8rpx 24rpx 0;
  padding: 14rpx 20rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  background: #f4f6fb;
  border-radius: var(--radius-md);
  border: 1rpx solid #e5e7eb;
}
.stranger-invite-bar {
  flex-shrink: 0;
  margin: 8rpx 24rpx 0;
  padding: 18rpx 22rpx;
  background: linear-gradient(135deg, #eef4ff 0%, #ffffff 100%);
  border: 1rpx solid #cfe0ff;
  border-radius: var(--radius-md);
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
}
.stranger-invite-main {
  flex: 1;
  min-width: 0;
}
.stranger-invite-decline {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #64748b;
  padding: 8rpx 12rpx;
}
.stranger-invite-decline:active {
  opacity: 0.75;
}
.stranger-invite-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}
.stranger-invite-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--text-hint);
}
.stranger-dock {
  flex-shrink: 0;
  margin: 12rpx 24rpx 8rpx;
  padding: 20rpx 22rpx 24rpx;
  background: #fff;
  border-radius: var(--radius-lg);
  border: 1rpx solid #e5e7eb;
  box-shadow: 0 8rpx 28rpx rgba(15, 23, 42, 0.06);
}
.stranger-dock-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}
.stranger-dock-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}
.stranger-dock-dismiss {
  font-size: 24rpx;
  color: var(--primary);
}
.stranger-dock-meta {
  font-size: 22rpx;
  color: var(--text-hint);
  margin-bottom: 16rpx;
}
.stranger-avatars {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 48rpx;
  margin-bottom: 16rpx;
}
.stranger-av {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #e5e7eb;
}
.stranger-av.peer-mask {
  background: #111827;
}
.stranger-av-img {
  width: 100%;
  height: 100%;
}
.stranger-av-ph {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
}
.stranger-av.me .stranger-av-ph {
  color: var(--text-secondary);
}
.stranger-plan-swiper {
  height: 220rpx;
  margin-bottom: 8rpx;
}
.stranger-plan-card {
  height: 100%;
  margin: 0 4rpx;
  padding: 16rpx 18rpx;
  background: #f9fafb;
  border-radius: var(--radius-md);
  border: 1rpx solid #eef0f3;
  box-sizing: border-box;
}
.stranger-plan-label {
  font-size: 22rpx;
  color: var(--primary);
  font-weight: 600;
  display: block;
  margin-bottom: 8rpx;
}
.stranger-plan-t {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  display: block;
  margin-bottom: 8rpx;
}
.stranger-plan-s {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.45;
  display: block;
  max-height: 120rpx;
  overflow: hidden;
}
.stranger-swiper-hint {
  display: block;
  font-size: 22rpx;
  color: var(--text-hint);
  text-align: center;
  margin-bottom: 16rpx;
}
.stranger-enter-room {
  width: 100%;
  font-size: 28rpx;
}

/* 群内协作计划卡片 */
.match-digest-row {
  padding: 8rpx 24rpx 16rpx;
}
.match-digest-card {
  background: linear-gradient(145deg, #eff6ff, #dbeafe);
  border-radius: var(--radius-md);
  padding: 20rpx 24rpx;
  border: 1rpx solid #bfdbfe;
}
.match-digest-tag {
  display: block;
  font-size: 22rpx;
  font-weight: 700;
  color: #1d4ed8;
  margin-bottom: 12rpx;
}
.match-digest-body {
  font-size: 26rpx;
  color: var(--text-primary);
  line-height: 1.65;
  white-space: pre-wrap;
  word-break: break-word;
}

.plan-card-row {
  padding: 8rpx 24rpx;
}
.plan-card {
  background: linear-gradient(135deg, #f0f6ff 0%, #ffffff 100%);
  border: 1rpx solid #cfe0ff;
  border-radius: var(--radius-lg);
  padding: 24rpx;
  box-shadow: var(--shadow-card);
}
.plan-card-tag {
  font-size: 22rpx;
  color: var(--primary);
  font-weight: 600;
  display: block;
  margin-bottom: 12rpx;
}
.plan-card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  display: block;
  margin-bottom: 12rpx;
}
.plan-card-summary {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.55;
  white-space: pre-wrap;
  display: block;
  margin-bottom: 16rpx;
}
.plan-card-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 12rpx;
  border-top: 1rpx solid rgba(47, 108, 246, 0.15);
}
.plan-card-row-switch {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.plan-card-switch-label {
  font-size: 26rpx;
  color: var(--text-secondary);
}
.plan-card-edit {
  font-size: 26rpx;
  color: var(--primary);
  font-weight: 500;
  padding: 12rpx 20rpx;
}
.plan-card-edit:active {
  opacity: 0.75;
}

/* 本轮云侧执行轨迹（chat 返回的 trace） */
.ai-trace-wrap {
  flex-shrink: 0;
  margin: 0 20rpx 8rpx;
  padding: 16rpx 20rpx;
  background: #f8fafc;
  border-radius: var(--radius-md);
  border: 1rpx solid var(--gray-2);
  max-height: 200rpx;
  overflow-y: auto;
}
.ai-trace-title {
  display: block;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--text-tertiary);
  margin-bottom: 12rpx;
  letter-spacing: 0.02em;
}
.ai-trace-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.ai-trace-row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 12rpx;
}
.ai-trace-mark {
  flex-shrink: 0;
  font-size: 22rpx;
  line-height: 1.4;
  width: 28rpx;
  text-align: center;
  color: var(--text-secondary);
}
.ai-trace-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.ai-trace-label {
  font-size: 24rpx;
  color: var(--text-primary);
  line-height: 1.4;
}
.ai-trace-detail {
  font-size: 20rpx;
  color: var(--text-tertiary);
  line-height: 1.35;
  word-break: break-all;
}
.ai-trace-ms {
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--text-tertiary);
  font-variant-numeric: tabular-nums;
}


/* AI 协作底栏：快捷话术 + 输入（与 wxml ai-composer 对应） */
.ai-composer {
  flex-shrink: 0;
  background: #fff;
  border-top: 1rpx solid var(--border);
  padding-bottom: calc(14rpx + env(safe-area-inset-bottom));
}
.ai-quick-prompts {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 12rpx 16rpx 4rpx;
  animation: aiQuickFadeIn 0.18s ease-out;
}
.ai-quick-chip {
  padding: 12rpx 22rpx;
  font-size: 26rpx;
  color: var(--primary);
  background: var(--primary-light);
  border-radius: 999rpx;
  border: 1rpx solid rgba(47, 108, 246, 0.22);
  line-height: 1.3;
}
.ai-quick-chip-hover {
  opacity: 0.88;
}
.input-bar--ai {
  border-top: none;
  padding-bottom: 0;
}

@keyframes aiQuickFadeIn {
  from {
    opacity: 0;
    transform: translateY(10rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 群内：匹配摘要 / 计划卡片（与云 msgType 对齐） */
.room-match-digest-text {
  white-space: pre-wrap;
  font-size: 24rpx;
  line-height: 1.55;
}
.room-plan-card-mini {
  padding: 18rpx 20rpx;
  border-radius: var(--radius-md);
  background: linear-gradient(135deg, #f0f6ff 0%, #ffffff 100%);
  border: 1rpx solid #cfe0ff;
}
.room-plan-card-mini-tag {
  font-size: 22rpx;
  color: var(--primary);
  font-weight: 600;
  display: block;
  margin-bottom: 8rpx;
}
.room-plan-card-mini-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  display: block;
  margin-bottom: 8rpx;
}
.room-plan-card-mini-sum {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.45;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 4;
  overflow: hidden;
}
.room-plan-card-mini-link {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--primary);
  font-weight: 500;
}
