.match-digest-row {
  padding: 8rpx 24rpx 16rpx;
}
.match-digest-card {
  background: linear-gradient(145deg, #eff6ff, #dbeafe);
  border-radius: var(--radius-md);
  padding: 20rpx 24rpx;
  border: 1rpx solid #bfdbfe;
}
.match-digest-tag {
  display: block;
  font-size: 22rpx;
  font-weight: 700;
  color: #1d4ed8;
  margin-bottom: 12rpx;
}
.match-digest-body {
  font-size: 26rpx;
  color: var(--text-primary);
  line-height: 1.65;
  white-space: pre-wrap;
  word-break: break-word;
}

