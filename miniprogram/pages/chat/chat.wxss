/* 娑堟伅鍒楄〃 */
.message-list { flex: 1; min-height: 0; height: 0; padding: 24rpx; overflow-y: auto; box-sizing: border-box; }
.message-list-has-planfab {
  padding-bottom: 140rpx;
}
.message-list-has-planfab {
  padding-bottom: 140rpx;
}
.msg-row { margin-bottom: 24rpx; display: flex; align-items: flex-start; gap: 12rpx; }
.msg-ai { justify-content: flex-start; }
.msg-user { justify-content: flex-end; }
.msg-body { max-width: 580rpx; min-width: 0; }
.msg-avatar { width: 72rpx; height: 72rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 36rpx; flex-shrink: 0; }
.msg-avatar-ai { background: var(--primary-light); }
.msg-avatar-ai-txt {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--primary);
  line-height: 1;
}

