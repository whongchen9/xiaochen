.collab-page {
  min-height: 100vh;
  background: var(--bg-page);
  box-sizing: border-box;
  padding: 24rpx;
}
.collab-hint {
  font-size: 24rpx;
  color: var(--text-hint);
  line-height: 1.5;
  margin-bottom: 24rpx;
}
.collab-loading {
  text-align: center;
  color: var(--text-hint);
  font-size: 26rpx;
  padding: 80rpx 0;
}
.collab-list {
  max-height: calc(100vh - 200rpx);
}
.collab-row {
  background: var(--bg-card);
  border-radius: var(--radius-md);
  border: 1rpx solid var(--border-light);
  padding: 28rpx 24rpx;
  margin-bottom: 16rpx;
}
.collab-row:active {
  opacity: 0.88;
}
.collab-title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
  display: block;
}
.collab-meta {
  font-size: 24rpx;
  color: var(--text-hint);
  margin-top: 10rpx;
  display: block;
}
.collab-empty {
  text-align: center;
  color: var(--text-hint);
  font-size: 26rpx;
  padding: 80rpx 24rpx;
}
