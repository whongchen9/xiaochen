.page {
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: var(--bg-page);
}

.state {
  padding: 48rpx;
  text-align: center;
  font-size: 28rpx;
  color: var(--text-secondary);
}

.state.err {
  color: var(--danger);
}

.card {
  background: #fff;
  border-radius: var(--radius-lg);
  padding: 28rpx 32rpx;
  box-shadow: var(--shadow-card);
  margin-bottom: 24rpx;
}

.kicker {
  display: block;
  font-size: 24rpx;
  color: var(--text-tertiary);
  margin-bottom: 12rpx;
}

.title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.35;
  margin-bottom: 8rpx;
}

.room-line {
  display: block;
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: 20rpx;
}

.summary {
  display: block;
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-word;
}

.hint-card {
  background: var(--primary-light);
  border-radius: var(--radius-lg);
  padding: 24rpx 28rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.5;
}

.draft-box {
  background: #fff;
  border-radius: var(--radius-lg);
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--gray-2);
}

.draft-label {
  display: block;
  font-size: 24rpx;
  color: var(--text-tertiary);
  margin-bottom: 12rpx;
}

.draft-text {
  display: block;
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.55;
  white-space: pre-wrap;
  word-break: break-word;
}

.actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.btn {
  margin: 0;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 999rpx;
  padding: 20rpx 32rpx;
}

.btn::after {
  border: none;
}

.btn.primary {
  background: linear-gradient(145deg, #3b82f6, #2563eb);
  color: #fff;
}

.btn.secondary {
  background: #fff;
  color: var(--primary);
  border: 1rpx solid rgba(37, 99, 235, 0.35);
}

.btn[disabled] {
  opacity: 0.45;
}

.foot-note {
  display: block;
  margin-top: 24rpx;
  font-size: 24rpx;
  color: var(--text-hint);
  line-height: 1.45;
}
