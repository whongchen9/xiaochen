.fc-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg-page);
  box-sizing: border-box;
}

.fc-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  background: var(--bg-card);
  border-bottom: 1rpx solid var(--border-light);
  flex-shrink: 0;
}

.fc-bar-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.fc-bar-link {
  font-size: 26rpx;
  color: var(--primary);
}

.fc-scroll {
  flex: 1;
  height: 0;
  padding: 16rpx 24rpx 12rpx;
  box-sizing: border-box;
}

.fc-row {
  display: flex;
  margin-bottom: 20rpx;
}

.fc-me {
  justify-content: flex-end;
}

.fc-them {
  justify-content: flex-start;
  align-items: flex-start;
  gap: 12rpx;
}

.fc-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #2f6cf6, #5b8def);
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.fc-bubble {
  max-width: 72%;
  padding: 18rpx 22rpx;
  border-radius: var(--radius-lg);
  font-size: 28rpx;
  line-height: 1.45;
  word-break: break-word;
}

.fc-bubble-me {
  background: var(--primary);
  color: #fff;
}

.fc-bubble-them {
  background: var(--bg-card);
  color: var(--text-primary);
  border: 1rpx solid var(--border-light);
}

.fc-input-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: var(--bg-card);
  border-top: 1rpx solid var(--border-light);
  flex-shrink: 0;
}

.fc-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  padding: 0 20rpx;
  background: var(--bg-page);
  border-radius: var(--radius-md);
  font-size: 28rpx;
}

.fc-send {
  padding: 16rpx 28rpx;
  border-radius: var(--radius-md);
  font-size: 26rpx;
  color: var(--text-hint);
  background: var(--gray-2);
}

.fc-send.on {
  color: #fff;
  background: var(--primary);
}
