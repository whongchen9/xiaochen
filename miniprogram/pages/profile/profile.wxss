/* 个人中心样式 */
.profile-page {
  background: var(--bg-page);
  min-height: 100vh;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* 头部 */
.profile-header { display: flex; align-items: center; background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%); padding: 48rpx 32rpx 60rpx; color: #fff; }
.profile-avatar { width: 100rpx; height: 100rpx; border-radius: 50%; background: rgba(255,255,255,0.2); display: flex; align-items: center; justify-content: center; font-size: 44rpx; margin-right: 24rpx; overflow: hidden; flex-shrink: 0; }
.profile-avatar-img { width: 100%; height: 100%; }
.profile-info { flex: 1; }
.profile-name { font-size: 34rpx; font-weight: 600; display: block; margin-bottom: 4rpx; }
.profile-name-row { display: flex; align-items: center; flex-wrap: wrap; gap: 8rpx; }
.profile-phone { font-size: 22rpx; opacity: 0.7; display: block; }
.profile-sub { font-size: 20rpx; opacity: 0.6; display: block; margin-top: 4rpx; }
.profile-edit-btn { font-size: 22rpx; padding: 8rpx 24rpx; border-radius: 28rpx; background: rgba(255,255,255,0.2); color: #fff; border: 1rpx solid rgba(255,255,255,0.4); flex-shrink: 0; }

/* 信用修复卡片 */
.credit-repair { margin: -36rpx 16rpx 12rpx; border-radius: var(--radius-lg); background: var(--bg-card); border: 2rpx solid var(--danger); overflow: hidden; position: relative; z-index: 2; }
.credit-repair-hd { display: flex; justify-content: space-between; align-items: center; background: var(--danger-light); padding: 20rpx 20rpx 12rpx; }
.credit-repair-title { font-size: 26rpx; font-weight: 500; color: var(--danger); }
.credit-repair-score { font-size: 24rpx; color: var(--danger); font-weight: 500; }
.credit-repair-desc { font-size: 22rpx; color: var(--text-secondary); padding: 12rpx 20rpx 0; display: block; line-height: 1.5; }
.credit-repair-actions { display: flex; gap: 12rpx; padding: 12rpx 20rpx; }
.credit-btn { flex: 1; height: 60rpx; line-height: 60rpx; text-align: center; font-size: 24rpx; border-radius: 30rpx; font-weight: 500; }
.credit-btn:active { opacity: .85; }
.credit-btn-charity { background: var(--primary-light); color: var(--primary); }
.credit-btn-help { background: var(--success-light); color: #0f6e56; }
.credit-progress { padding: 0 20rpx 20rpx; }
.credit-progress-label { font-size: 20rpx; color: var(--text-hint); display: block; margin-bottom: 6rpx; }
.credit-progress-bar { width: 100%; height: 12rpx; border-radius: 6rpx; background: var(--bg-input); overflow: hidden; }
.credit-progress-fill { height: 100%; border-radius: 6rpx; background: var(--warning); transition: width .3s; }
.credit-progress-num { font-size: 20rpx; color: var(--text-hint); margin-top: 4rpx; display: block; text-align: right; }

/* 信用档案（正常时） */
.credit-archive { margin: -36rpx 16rpx 12rpx; border-radius: var(--radius-lg); background: var(--bg-card); padding: 20rpx; position: relative; z-index: 2; box-shadow: var(--shadow-card); }
.credit-archive-title { font-size: 26rpx; font-weight: 500; color: var(--text-primary); display: block; margin-bottom: 12rpx; }
.credit-archive-row { display: flex; gap: 10rpx; }
.credit-chip { font-size: 22rpx; padding: 8rpx 18rpx; border-radius: 24rpx; background: var(--bg-input); color: var(--text-primary); }
.credit-chip.chip-warn { background: var(--danger-light); color: var(--danger); }

/* 个人标签 */
.tag-section { margin: 0 16rpx 12rpx; border-radius: var(--radius-lg); background: var(--bg-card); padding: 20rpx; box-shadow: var(--shadow-card); }
.tag-section-hd { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.tag-section-title { font-size: 28rpx; font-weight: 500; color: var(--text-primary); }
.tag-section-edit { font-size: 22rpx; color: var(--primary); }
.tag-list { display: flex; flex-wrap: wrap; gap: 10rpx; }
.tag-chip { font-size: 22rpx; padding: 8rpx 20rpx; border-radius: 24rpx; }
.tag-chip-blue { background: var(--primary-light); color: var(--primary); }
.tag-chip-add { background: var(--bg-input); color: var(--text-hint); border: 1rpx dashed var(--border); }

/* 协作历史 */
.history-section { margin: 0 16rpx 12rpx; border-radius: var(--radius-lg); background: var(--bg-card); padding: 20rpx; box-shadow: var(--shadow-card); }
.history-hd { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.history-title { font-size: 28rpx; font-weight: 500; color: var(--text-primary); }
.history-more { font-size: 22rpx; color: var(--primary); }
.history-list { display: flex; gap: 12rpx; flex-wrap: wrap; }
.history-item { flex: 1; min-width: 200rpx; padding: 16rpx; border-radius: var(--radius-md); }
.history-item-done { background: var(--success-light); }
.history-item-title { font-size: 26rpx; font-weight: 500; display: block; margin-bottom: 4rpx; }
.history-item-done .history-item-title { color: #0f6e56; }
.history-item-meta { font-size: 20rpx; display: block; }
.history-item-done .history-item-meta { color: rgba(15,110,86,.7); }
.history-empty { font-size: 22rpx; color: var(--text-hint); text-align: center; padding: 20rpx; }

.history-placeholder {
  padding: 32rpx 16rpx 28rpx;
  text-align: center;
  border-radius: var(--radius-md);
  background: var(--bg-input);
  border: 1rpx dashed var(--border);
}
.history-placeholder-text {
  font-size: 24rpx;
  color: var(--text-hint);
  line-height: 1.5;
}

.token-demo-banner {
  display: block;
  font-size: 22rpx;
  color: #b45309;
  background: #fffbeb;
  border: 1rpx solid #fde68a;
  border-radius: 12rpx;
  padding: 12rpx 16rpx;
  line-height: 1.45;
  margin-bottom: 16rpx;
}
/* Token 卡（跟之前一样，只改间距） */
.token-card { margin: 0 16rpx 12rpx; border-radius: var(--radius-lg); padding: 20rpx; box-shadow: var(--shadow-card); background: var(--bg-card); }
.token-card-hd { margin-bottom: 12rpx; }
.token-card-title { font-size: 28rpx; font-weight: 500; color: var(--text-primary); display: block; }
.token-card-hint { font-size: 22rpx; color: var(--text-hint); display: block; margin-top: 4rpx; }
.token-card-actions { display: flex; gap: 12rpx; }
.token-ad-btn, .token-vip-btn {
  flex: 1; height: 80rpx; border-radius: 40rpx; border: none; font-size: 24rpx; font-weight: 500;
  padding: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; line-height: 1.3;
}
.token-ad-btn { background: var(--primary-light); color: var(--primary); border: 1rpx solid #cce5ff; }
.token-ad-btn:active { opacity: .85; }
.token-ad-btn[disabled] { opacity: .4; }
.token-ad-sub, .token-vip-sub { font-size: 18rpx; font-weight: 400; opacity: .7; }
.token-vip-btn { background: linear-gradient(135deg, var(--warning), #ffb300); color: #5c3d00; }
.token-vip-btn:active { opacity: .85; }
.token-ad-hint { text-align: center; font-size: 20rpx; color: var(--text-hint); margin-top: 10rpx; }

/* VIP 活跃状态 */
.vip-active-card {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 12rpx;
  background: var(--warning-light);
  margin: 0 16rpx 12rpx;
  border-radius: var(--radius-lg);
  padding: 20rpx 24rpx;
  border: 1rpx solid #ffe0b2;
}
.token-demo-banner--vip {
  margin-bottom: 0;
}
.vip-active-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.vip-icon { font-size: 48rpx; }
.vip-info { flex: 1; }
.vip-title { font-size: 28rpx; font-weight: 600; color: var(--warning); display: block; }
.vip-expire { font-size: 22rpx; color: var(--warning); display: block; margin-top: 4rpx; opacity: .7; }
.vip-renew-btn { flex-shrink: 0; height: 40rpx; padding: 0 8rpx; border-radius: 20rpx; font-size: 22rpx; font-weight: 500; background: var(--warning); color: #fff; border: none; line-height: 40rpx; }

/* 勋章墙（折叠） */
.medal-wall { margin: 0 16rpx 12rpx; border-radius: var(--radius-lg); padding: 20rpx; box-shadow: var(--shadow-card); background: var(--bg-card); }
.medal-wall-hd { display: flex; justify-content: space-between; align-items: center; font-size: 28rpx; font-weight: 500; color: var(--text-primary); margin-bottom: 12rpx; }
.medal-wall-arrow { font-size: 22rpx; color: var(--primary); font-weight: 400; }
.medal-preview { font-size: 36rpx; }
.medal-empty-hint { font-size: 22rpx; color: var(--text-hint); }
.medal-list { display: flex; flex-wrap: wrap; gap: 16rpx; }
.medal-item { width: 140rpx; text-align: center; padding: 12rpx 8rpx; border-radius: var(--radius-md); background: var(--bg-page); }
.medal-icon { width: 56rpx; height: 56rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 28rpx; margin: 0 auto 8rpx; }
.medal-name { font-size: 22rpx; font-weight: 500; color: var(--text-primary); display: block; margin-bottom: 2rpx; }
.medal-desc { font-size: 18rpx; color: var(--text-hint); display: block; }
.medal-item.locked { opacity: 0.7; }

/* 菜单 */
.profile-menu { background: var(--bg-card); border-radius: var(--radius-lg); margin: 0 16rpx 12rpx; overflow: hidden; box-shadow: var(--shadow-card); }
.menu-item { display: flex; justify-content: space-between; align-items: center; padding: 28rpx 24rpx; border-bottom: 1rpx solid var(--border-light); }
.menu-item:last-child { border-bottom: none; }
.menu-item:active { background: #fafafa; }
.menu-left { display: flex; align-items: center; gap: 16rpx; font-size: 28rpx; color: var(--text-primary); }
.menu-icon { font-size: 32rpx; }
.menu-arrow { font-size: 36rpx; color: var(--text-hint); font-weight: 300; }

/* VIP 选档弹层（居中） */
.vip-sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 1950;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx 40rpx;
  box-sizing: border-box;
}
.vip-sheet-card {
  width: 100%;
  max-width: 620rpx;
  background: var(--bg-card);
  border-radius: 24rpx;
  padding: 28rpx 28rpx 24rpx;
  box-sizing: border-box;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.15);
}
.vip-sheet-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.vip-sheet-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}
.vip-sheet-close {
  font-size: 26rpx;
  color: var(--text-secondary);
  padding: 12rpx 20rpx;
  border-radius: 12rpx;
}
.vip-sheet-close:active {
  background: var(--bg-input);
}
.vip-sheet-line {
  display: block;
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.55;
  margin-bottom: 12rpx;
}
.vip-sheet-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 24rpx;
}
.vip-sheet-plan {
  text-align: center;
  padding: 24rpx;
  border-radius: var(--radius-md);
  font-size: 28rpx;
  font-weight: 500;
}
.vip-sheet-plan-month {
  background: var(--primary);
  color: #fff;
}
.vip-sheet-plan-month:active {
  opacity: 0.9;
}
.vip-sheet-plan-year {
  background: var(--bg-input);
  color: var(--text-primary);
  border: 1rpx solid var(--border-light);
}
.vip-sheet-plan-year:active {
  opacity: 0.88;
}

/* 标签编辑底部面板 */
.tag-editor-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 2000;
  display: flex;
  align-items: flex-end;
}
.tag-editor-sheet {
  width: 100%;
  background: var(--bg-card);
  border-radius: 24rpx 24rpx 0 0;
  padding: 24rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.tag-editor-hd { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.tag-editor-title { font-size: 30rpx; font-weight: 600; color: var(--text-primary); }
.tag-editor-close { font-size: 36rpx; color: var(--text-hint); padding: 8rpx; }
.tag-editor-hint { font-size: 22rpx; color: var(--text-hint); display: block; margin-bottom: 16rpx; }
.tag-editor-textarea {
  width: 100%;
  min-height: 160rpx;
  padding: 16rpx;
  border-radius: var(--radius-md);
  background: var(--bg-input);
  font-size: 26rpx;
  box-sizing: border-box;
}
.tag-editor-ft { display: flex; gap: 16rpx; margin-top: 20rpx; }
.tag-editor-btn {
  flex: 1;
  text-align: center;
  padding: 22rpx;
  border-radius: var(--radius-md);
  font-size: 28rpx;
}
.tag-editor-btn.cancel { background: var(--bg-input); color: var(--text-secondary); }
.tag-editor-btn.ok { background: var(--primary); color: #fff; }