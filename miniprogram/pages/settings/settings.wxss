.page {
  min-height: 100vh;
  background: #f5f6fa;
  padding: 24rpx;
  box-sizing: border-box;
}

.group {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  border: 1rpx solid #eee;
  margin-bottom: 24rpx;
}

.group-title {
  padding: 24rpx 24rpx 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.group-body {
  padding: 0 24rpx 24rpx;
}

.match-intro {
  display: block;
  margin-bottom: 16rpx;
  font-size: 22rpx;
  color: #999;
  line-height: 1.45;
}

.field-label {
  display: block;
  margin-top: 20rpx;
  font-size: 26rpx;
  font-weight: 500;
  color: #333;
}

.field-label:first-of-type {
  margin-top: 0;
}

.field-hint {
  display: block;
  margin-top: 8rpx;
  margin-bottom: 12rpx;
  font-size: 22rpx;
  color: #999;
  line-height: 1.45;
}

.match-pill-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.match-pill {
  font-size: 22rpx;
  padding: 10rpx 20rpx;
  border-radius: 28rpx;
  background: #f5f6fa;
  color: #666;
  border: 1rpx solid #e8e8e8;
}

.match-pill.on {
  background: #e8edff;
  color: #1a4fd0;
  border-color: rgba(26, 79, 208, 0.35);
  font-weight: 500;
}

.match-cap-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.match-cap {
  font-size: 22rpx;
  padding: 10rpx 22rpx;
  border-radius: 28rpx;
  background: #f5f6fa;
  color: #666;
  border: 1rpx solid #e8e8e8;
}

.match-cap.on {
  background: #e1f5ee;
  color: #0f6e56;
  border-color: rgba(15, 110, 86, 0.35);
  font-weight: 500;
}

.match-pref-save {
  margin-top: 24rpx;
  width: 100%;
  font-size: 28rpx;
}

.phone-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 0 24rpx 16rpx;
}

.phone-input {
  flex: 1;
  height: 72rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  background: #f5f6fa;
  border-radius: 12rpx;
  box-sizing: border-box;
}

.phone-save {
  flex-shrink: 0;
}

.cell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
  font-size: 28rpx;
}

.cell:last-child {
  border-bottom: none;
}

.cell-label {
  color: #333;
}

.hint {
  margin-top: 24rpx;
  font-size: 24rpx;
  color: #999;
  line-height: 1.5;
}

.hint.inner {
  display: block;
  margin-top: 0;
  margin-bottom: 16rpx;
  padding: 0 24rpx;
  font-size: 22rpx;
  line-height: 1.45;
}
